
@using System.Collections.Generic
@using PagedList
@using PagedList.Mvc
@model MiniSocialMedia.Models.ViewModle.NewsfeedVM
@{
    var likeCounts = ViewBag.LikeCounts as Dictionary<int, int>
                     ?? new Dictionary<int, int>();

    var userReactions = ViewBag.UserReactions
                    as Dictionary<int, string>
                    ?? new Dictionary<int, string>();

    var reactionCounts = ViewBag.ReactionCounts
        as Dictionary<string, int>
        ?? new Dictionary<string, int>();

}

@{
    ViewBag.Title = "Bảng tin";
    <style>
        body {
            background: #eaf0f8;
        }

        .newsfeed-title {
            text-align: center;
            color: #1264d8;
            font-size: 32px;
            font-weight: 800;
            margin: 35px 0 25px;
        }

        .create-post-card {
            background: white;
            border-radius: 20px;
            padding: 28px;
            margin-bottom: 35px;
            box-shadow: 0 5px 20px rgba(0,0,0,.08);
            border-top: 5px solid #1877f2;
        }

            .create-post-card h4 {
                font-weight: 700;
                color: #1877f2;
                margin-bottom: 20px;
            }

            .create-post-card textarea {
                border-radius: 12px;
                padding: 15px;
            }

        .section-title {
            font-size: 24px;
            font-weight: 750;
            margin-bottom: 20px;
        }

        .post-card {
            background: white;
            border-radius: 20px;
            padding: 25px;
            margin-bottom: 30px;
            box-shadow: 0 5px 20px rgba(0,0,0,.08);
            border: none;
        }

        .post-header {
            display: flex;
            align-items: center;
            gap: 14px;
            padding-bottom: 12px;
            margin-bottom: 0;
            border-bottom: 1px solid #edf0f4;
        }

        .post-avatar {
            width: 55px;
            height: 55px;
            border-radius: 50%;
            background: linear-gradient(135deg,#1877f2,#65a5ff);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 23px;
            font-weight: bold;
            flex-shrink: 0;
        }

        .post-user {
            font-size: 18px;
            font-weight: 750;
        }

        .post-date {
            color: #788391;
            font-size: 13px;
            margin-top: 4px;
        }

        .post-content {
            font-size: 17px;
            line-height: 1.6;
            color: #242a35;
            padding: 12px 0;
            margin: 0;
            text-align: left;
            white-space: pre-wrap;
            overflow-wrap: anywhere;
            min-height: auto;
        }

        .post-image {
            display: block;
            width: 100%;
            max-height: 550px;
            object-fit: contain;
            border-radius: 15px;
            background: #f5f7fa;
            margin: 10px 0 20px;
        }

        .like-form {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .comment-box {
            background: #f1f5fa;
            border-radius: 13px;
            padding: 15px;
            margin: 12px 0;
        }

        .post-card h6 {
            font-weight: bold;
            margin-bottom: 15px;
        }

        .post-card .btn,
        .create-post-card .btn {
            border-radius: 9px;
        }

        .post-actions {
            display: flex;
            gap: 10px;
            margin-top: 18px;
        }
        /* Chỉnh riêng phần nội dung bài viết */
        .post-card > .post-content {
            display: block !important;
            width: 100% !important;
            height: auto !important;
            min-height: 0 !important;
            padding: 12px 0 !important;
            margin: 0 !important;
            text-align: left !important;
            line-height: 1.6 !important;
            font-size: 17px;
            color: #242a35;
            white-space: pre-wrap;
            overflow-wrap: anywhere;
        }

            .post-card > .post-content p {
                padding: 0 !important;
                margin: 0 !important;
                text-align: left !important;
            }
        /* Thu gọn giao diện từng bài viết */
        .post-card {
            padding: 18px !important;
            margin-bottom: 18px !important;
            border-radius: 15px;
        }

        .post-header {
            padding-bottom: 8px !important;
            margin-bottom: 0 !important;
        }

        .post-content {
            padding: 8px 0 !important;
            margin: 0 !important;
            line-height: 1.5 !important;
            min-height: 0 !important;
        }

        .post-actions {
            margin-top: 10px !important;
            gap: 8px;
        }

        .comment-box {
            padding: 10px !important;
            margin: 8px 0 !important;
        }

        .reaction-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .reaction-btn {
            border-radius: 20px !important;
            font-weight: 600;
        }

            .reaction-btn.active {
                background-color: #1877f2;
                color: white;
                border-color: #1877f2;
            }
    </style>



}


<div class="container mt-4">
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-info">
            @TempData["Message"]
        </div>
    }

    <h2 class="newsfeed-title">BẢNG TIN MINI SOCIAL MEDIA</h2>
    <hr />

    <div class="create-post-card">
        <h4>Bạn đang nghĩ gì?</h4>

        @using (Html.BeginForm("CreatePost", "Post",
            FormMethod.Post,
            new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()

            <textarea name="Content"
                      class="form-control"
                      rows="4"
                      placeholder="Nhập nội dung bài viết..."
                      required></textarea>

            <br />

            <input type="file"
                   name="ImageFile"
                   accept="image/*"
                   class="form-control" />

            <br />

            <button type="submit" class="btn btn-primary">
                Đăng bài viết
            </button>
        }
    </div>

    <h4 class="section-title">Bài viết mới nhất</h4>
    @using (Html.BeginForm("Newsfeed", "Post", FormMethod.Get))
    {
        <div class="input-group mb-3">

            <input type="text"
                   name="searchString"
                   class="form-control"
                   placeholder="Tìm kiếm bài viết..."
                   value="@ViewBag.SearchString" />

            <button type="submit" class="btn btn-primary">
                Tìm kiếm
            </button>

            <a href="@Url.Action("Newsfeed", "Post")"
               class="btn btn-secondary">
                Làm mới
            </a>

        </div>
    }

    <hr />

    @if (Model.Posts != null && Model.Posts.Any())
    {
        foreach (var post in Model.Posts)
        {
            <div class="post-card">

                <div class="post-header">

                    <div class="post-avatar">
                        @(
                post.User != null &&
                !string.IsNullOrEmpty(post.User.Username)
                ? post.User.Username.Substring(0, 1).ToUpper()
                : "U"
            )
                    </div>

                    <div>
                        <div class="post-user">
                            @(post.User != null
                    ? post.User.FullName
                    : "Người dùng")
                        </div>

                        <div class="post-date">
                            @post.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    </div>

                </div>

                <div class="post-content">
                    @Html.Raw(Html.Encode(post.Content).Replace("\n", "<br />"))
                </div>
                @if (!string.IsNullOrEmpty(post.ImageUrl))
                {
                    <img src="@post.ImageUrl"
                         class="post-image"
                         alt="Ảnh bài viết" />
                }

                <div class="mt-2 mb-3">

                    @using (Html.BeginForm("ToggleReaction", "Post", FormMethod.Post,
                        new { @class = "reaction-form" }))
                    {
                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="postId"
                               value="@post.PostId" />

                        <div class="reaction-buttons">

                            <button type="button"
                                    class="btn btn-outline-primary btn-sm reaction-btn @(userReactions.ContainsKey(post.PostId) && userReactions[post.PostId] == "Like" ? "active" : "")"
                                    data-reaction="Like">
                                👍 Like
                            </button>

                            <button type="button"
                                    class="btn btn-outline-danger btn-sm reaction-btn @(userReactions.ContainsKey(post.PostId) && userReactions[post.PostId] == "Love" ? "active" : "")"
                                    data-reaction="Love">
                                ❤️ Love
                            </button>

                            <button type="button"
                                    class="btn btn-outline-warning btn-sm reaction-btn @(userReactions.ContainsKey(post.PostId) && userReactions[post.PostId] == "Haha" ? "active" : "")"
                                    data-reaction="Haha">
                                😂 Haha
                            </button>

                            <button type="button"
                                    class="btn btn-outline-info btn-sm reaction-btn @(userReactions.ContainsKey(post.PostId) && userReactions[post.PostId] == "Wow" ? "active" : "")"
                                    data-reaction="Wow">
                                😮 Wow
                            </button>

                            <button type="button"
                                    class="btn btn-outline-secondary btn-sm reaction-btn @(userReactions.ContainsKey(post.PostId) && userReactions[post.PostId] == "Sad" ? "active" : "")"
                                    data-reaction="Sad">
                                😢 Sad
                            </button>

                            <button type="button"
                                    class="btn btn-outline-dark btn-sm reaction-btn @(userReactions.ContainsKey(post.PostId) && userReactions[post.PostId] == "Angry" ? "active" : "")"
                                    data-reaction="Angry">
                                😡 Angry
                            </button>

                        </div>

                        <input type="hidden"
                               name="reactionType"
                               class="reaction-type" />

                        <div class="reaction-summary mt-2">

                            👍
                            @(reactionCounts.ContainsKey(post.PostId + "_Like")
        ? reactionCounts[post.PostId + "_Like"] : 0)
                            ❤️
                            @(reactionCounts.ContainsKey(post.PostId + "_Love")
        ? reactionCounts[post.PostId + "_Love"] : 0)
                            😂
                            @(reactionCounts.ContainsKey(post.PostId + "_Haha")
        ? reactionCounts[post.PostId + "_Haha"] : 0)
                            😮
                            @(reactionCounts.ContainsKey(post.PostId + "_Wow")
        ? reactionCounts[post.PostId + "_Wow"] : 0)
                            😢
                            @(reactionCounts.ContainsKey(post.PostId + "_Sad")
        ? reactionCounts[post.PostId + "_Sad"] : 0)
                            😡
                            @(reactionCounts.ContainsKey(post.PostId + "_Angry")
        ? reactionCounts[post.PostId + "_Angry"] : 0)

                            <div class="mt-1">
                                Tổng:
                                <strong class="reaction-count">
                                    @(likeCounts.ContainsKey(post.PostId)
                ? likeCounts[post.PostId] : 0)
                                </strong>
                                biểu cảm
                            </div>

                        </div>
                    }

                </div>

                <hr />

                <h6>Bình luận</h6>

                @using (Html.BeginForm("CreateComment", "Post", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="postId" value="@post.PostId" />

                    <div class="input-group mb-3">
                        <input type="text"
                               name="Content"
                               class="form-control"
                               placeholder="Viết bình luận..."
                               maxlength="1000"
                               required />

                        <button type="submit" class="btn btn-primary">
                            Bình luận
                        </button>
                    </div>
                }
                @if (post.Comments != null && post.Comments.Any())
                {
                    foreach (var comment in post.Comments.OrderBy(c => c.CreatedAt))
                    {
                        <div class="comment-box">
                            <strong>
                                @comment.User.Username
                            </strong>

                            <p class="mb-1">
                                @comment.Content
                            </p>

                            <small class="text-muted">
                                @comment.CreatedAt
                            </small>
                            @if (comment.UserId == Model.CurrentUserId)
                            {
                                <div class="mt-2">

                                    @* Form sửa bình luận *@
                                    @using (Html.BeginForm("EditComment", "Post", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@comment.CommentId" />

                                        <div class="input-group mb-2">
                                            <input type="text"
                                                   name="Content"
                                                   class="form-control"
                                                   value="@comment.Content"
                                                   maxlength="1000"
                                                   required />

                                            <button type="submit"
                                                    class="btn btn-warning btn-sm">
                                                Lưu sửa
                                            </button>
                                        </div>
                                    }

                                    @* Form xóa bình luận *@
                                    @using (Html.BeginForm("DeleteComment", "Post", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@comment.CommentId" />

                                        <button type="submit"
                                                class="btn btn-danger btn-sm"
                                                onclick="return confirm('Bạn có chắc muốn xóa bình luận này không?');">
                                            Xóa bình luận
                                        </button>
                                    }

                                </div>
                            }
                            ```
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted">Chưa có bình luận nào.</p>
                }

                @if (post.UserId == Model.CurrentUserId || string.Equals(Session["Role"] as string, "Admin",StringComparison.OrdinalIgnoreCase))
                
                    {
                        <div class="mt-3">

                            <a href="@Url.Action("EditPost", "Post", new { id = post.PostId })"
                               class="btn btn-warning btn-sm">
                                Sửa bài viết
                            </a>

                            @using (Html.BeginForm("DeletePost", "Post",
                                FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@post.PostId" />

                                <button type="submit"
                                        class="btn btn-danger btn-sm"
                                        onclick="return confirm('Bạn có chắc muốn xóa bài viết này không?');">
                                    Xóa bài viết
                                </button>
                            }

                        </div>
                    }

                </div>
        }
    }
    else
    {
        <div class="alert alert-warning">
            Chưa có bài viết nào.
        </div>
    }

    @if (Model.Posts.PageCount > 1)
    {
        <nav class="custom-pagination" aria-label="Chuyển trang">
            <ul class="pagination-list">

                @* Nút trang trước *@
                @if (Model.Posts.HasPreviousPage)
                {
                    <li>
                        <a href="@Url.Action("Newsfeed", new {
                        page = Model.Posts.PageNumber - 1,
                        searchString = ViewBag.SearchString
                    })">
                            &laquo; Trước
                        </a>
                    </li>
                }

                @* Các số trang *@
                @for (int i = 1; i <= Model.Posts.PageCount; i++)
                {
                    <li class="@(i == Model.Posts.PageNumber ? "active" : "")">
                        <a href="@Url.Action("Newsfeed", new {
                        page = i,
                        searchString = ViewBag.SearchString
                    })">
                            @i
                        </a>
                    </li>
                }

                @* Nút trang sau *@
                @if (Model.Posts.HasNextPage)
                {
                    <li>
                        <a href="@Url.Action("Newsfeed", new {
                        page = Model.Posts.PageNumber + 1,
                        searchString = ViewBag.SearchString
                    })">
                            Sau &raquo;
                        </a>
                    </li>
                }

            </ul>
        </nav>
    }

    <style>
        .custom-pagination {
            display: flex;
            justify-content: center;
            margin: 30px 0;
        }

        .pagination-list {
            display: flex;
            justify-content: center;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px;
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .pagination-list li a {
                display: block;
                min-width: 42px;
                padding: 10px 15px;
                text-align: center;
                text-decoration: none;
                color: #2878f0;
                background: white;
                border: 1px solid #dce3ed;
                border-radius: 9px;
                font-weight: 600;
                transition: all 0.2s ease;
            }

                .pagination-list li a:hover {
                    color: white;
                    background: #2878f0;
                    border-color: #2878f0;
                    transform: translateY(-2px);
                }

            .pagination-list li.active a {
                color: white;
                background: #2878f0;
                border-color: #2878f0;
                box-shadow: 0 3px 8px rgba(40, 120, 240, 0.25);
                pointer-events: none;
            }
    </style>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        document.querySelectorAll(".reaction-form").forEach(function (form) {

            var buttons = form.querySelectorAll(".reaction-btn");
            var reactionInput = form.querySelector(".reaction-type");
            var count = form.querySelector(".reaction-count");

            buttons.forEach(function (button) {

                button.addEventListener("click", function () {

                    var selectedReaction = button.dataset.reaction;

                    reactionInput.value = selectedReaction;

                    var formData = new FormData(form);

                    fetch(form.action, {
                        method: "POST",
                        body: formData
                    })
                        .then(response => response.json())
                        .then(data => {

                            if (data.success) {

                                count.textContent = data.totalReactions;

                                buttons.forEach(function (btn) {
                                    btn.classList.remove("active");
                                });

                                if (data.isReacted) {
                                    buttons.forEach(function (btn) {
                                        if (btn.dataset.reaction === data.reactionType) {
                                            btn.classList.add("active");
                                        }
                                    });
                                }
                            }
                            else {
                                alert(data.message);
                            }

                        })
                        .catch(error => {
                            alert("Có lỗi xảy ra khi biểu cảm!");
                            console.error(error);
                        });

                });

            });

        });

    });
</script>
